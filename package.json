{
  "name": "telegram-nft-bot",
  "version": "0.1.0",
  "description": "Telegram-controlled fast NFT minting bot for EVM and Solana FCFS drops",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/web/public','dist/web/public',{recursive:true})\"",
    "start": "node dist/index.js",
    "import-wallet": "tsx scripts/import-wallet.ts",
    "export-wallet": "tsx scripts/export-wallet.ts"
  },
  "dependencies": {
    "grammy": "^1.21.1",
    "viem": "^2.9.0",
    "@solana/web3.js": "^1.91.0",
    "@solana/spl-token": "^0.4.6",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsx": "^4.7.0",
    "@types/node": "^20.11.0",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0"
  }
}
