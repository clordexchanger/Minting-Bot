# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OPERATOR_ID=

# EVM RPCs — JSON mapping chainId to one URL or an array of URLs (array = broadcast
# to all of them at once for that chain). One Alchemy API key works across every
# network below, you just swap the subdomain. Delete entries you don't need.
#
# Chain ID / Alchemy subdomain reference (mainnet / testnet):
#   Ethereum      1 / 11155111        eth-mainnet / eth-sepolia
#   Base          8453 / 84532        base-mainnet / base-sepolia
#   Arbitrum      42161 / 421614      arb-mainnet / arb-sepolia
#   Zora          7777777 / 999999999 zora-mainnet / zora-sepolia
#     NOTE: Alchemy's Zora support is primarily Account Abstraction endpoints —
#     test a plain eth_sendRawTransaction mint here before relying on it.
#   Abstract      2741 / 11124        abstract-mainnet / abstract-testnet
#   Monad         143 / 10143         monad-mainnet / monad-testnet
#     NOTE: Monad mainnet is a very recent Alchemy addition — verify the
#     "monad-mainnet" subdomain and chainId 143 in your dashboard before use.
#   Ronin         2020 / 2021         ronin-mainnet / ronin-saigon
#   Hyperliquid   999 / 998           hyperliquid-mainnet / hyperliquid-testnet
#   Plasma        9745 / 9746         plasma-mainnet / plasma-testnet
#   Robinhood     4663 / 46630        robinhood-mainnet / robinhood-testnet
#     NOTE: mainnet chainId/subdomain here are less certain than the others —
#     confirm in your Alchemy dashboard.
#
# URL pattern: https://<subdomain>.g.alchemy.com/v2/<yourApiKey>
EVM_RPC_URLS={"1":"https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY","11155111":"https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY","8453":"https://base-mainnet.g.alchemy.com/v2/YOUR_KEY","84532":"https://base-sepolia.g.alchemy.com/v2/YOUR_KEY","42161":"https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY","421614":"https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY","7777777":"https://zora-mainnet.g.alchemy.com/v2/YOUR_KEY","999999999":"https://zora-sepolia.g.alchemy.com/v2/YOUR_KEY","2741":"https://abstract-mainnet.g.alchemy.com/v2/YOUR_KEY","11124":"https://abstract-testnet.g.alchemy.com/v2/YOUR_KEY","143":"https://monad-mainnet.g.alchemy.com/v2/YOUR_KEY","10143":"https://monad-testnet.g.alchemy.com/v2/YOUR_KEY","2020":"https://ronin-mainnet.g.alchemy.com/v2/YOUR_KEY","2021":"https://ronin-saigon.g.alchemy.com/v2/YOUR_KEY","999":"https://hyperliquid-mainnet.g.alchemy.com/v2/YOUR_KEY","998":"https://hyperliquid-testnet.g.alchemy.com/v2/YOUR_KEY","9745":"https://plasma-mainnet.g.alchemy.com/v2/YOUR_KEY","9746":"https://plasma-testnet.g.alchemy.com/v2/YOUR_KEY","4663":"https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY","46630":"https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY"}

# Solana. Recommended: Helius.
SOLANA_RPC_URLS=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Wallets
WALLET_KEYSTORE_PATH=./data/keystore.enc.json
WALLET_KEYSTORE_PASSPHRASE=

# Data
TARGETS_FILE=./data/targets.json

# Web dashboard — off by default. Set to true plus a strong password to enable
# a one-click browser UI alongside the Telegram bot. Do NOT enable this
# without also putting it behind HTTPS (see deploy/README.md) — logging in
# over plain HTTP sends your password in the clear.
WEB_DASHBOARD_ENABLED=false
WEB_DASHBOARD_PORT=8443
WEB_DASHBOARD_PASSWORD=
# Any long random string — used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEB_SESSION_SECRET=
# Set true only once actually served over HTTPS — browsers refuse "secure"
# cookies over plain HTTP, which silently breaks login.
WEB_COOKIE_SECURE=false
